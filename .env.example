# Sao chép file này thành .env rồi sửa theo ý bạn

# Cổng máy chủ (tunnel trỏ vào cổng này)
PORT=8787

# SĐT quản trị viên: được tạo/sửa/xóa mẫu dùng chung. Nhiều số cách nhau bằng dấu phẩy
ADMIN_PHONES=

# Chỉ cho phép các SĐT này dùng máy chủ. Để trống = mọi SĐT đều dùng được
# (nên điền vì tunnel mở ra Internet). Quản trị viên luôn được phép.
ALLOWED_PHONES=

# Thư mục lưu dữ liệu mẫu (mặc định: ./data)
DATA_DIR=data
